{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "sofia",
      "camelcase": "Sofia",
      "title": "Sofia",
      "scope": "source.sofia",
      "file-types": [
        "sofia"
      ],
      "injection-regex": "^sofia$",
      "class-name": "TreeSitterSofia"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Parser for the Sofia programming language",
    "authors": [
      {
        "name": "Luís Felipe Ramos Ferreira",
        "email": "lframos.lf@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-sofia"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}